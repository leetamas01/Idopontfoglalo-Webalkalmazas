@model IEnumerable<IdopontfoglaloWebalk.Models.Services>

@{
    ViewData["Title"] = "Saját szolgáltatásaim";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Saját szolgáltatásaim</h1>
            <p class="text-muted mb-0">Itt kezelheted a hirdetéseidet és láthatod a foglalásaidat.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-lg rounded-pill shadow-sm px-4" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                <i class="bi bi-tag-fill me-1"></i> Új kategória
            </button>
            <a asp-action="Create" class="btn btn-success btn-lg rounded-pill shadow-sm px-4">
                <i class="bi bi-plus-lg me-1"></i> Új szolgáltatás
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Szolgáltatás neve</th>
                        <th>Helyszín</th>
                        <th>Értékelés</th>
                        <th class="text-center">Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                Még nincs létrehozott szolgáltatásod. Kattints az "Új szolgáltatás" gombra!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">@item.name</span>
                                </td>
                                <td><i class="bi bi-geo-alt-fill text-muted me-1"></i> @item.address</td>
                                <td>
                                    <span class="badge bg-warning text-dark rounded-pill">
                                        <i class="bi bi-star-fill"></i> @item.rating.ToString("0.0")
                                    </span>
                                </td>
                                <td class="text-center px-4">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                        <a asp-action="Calendar" asp-route-id="@item.service_id" class="btn btn-primary btn-sm px-3">
                                            <i class="bi bi-calendar3"></i> Naptár
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.service_id" class="btn btn-light btn-sm px-3 border-start">
                                            Szerkesztés
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.service_id" class="btn btn-outline-danger btn-sm px-3 border-start">
                                            Törlés
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createCategoryModalLabel">Új főkategória hozzáadása</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
            </div>
            <form asp-controller="Services" asp-action="AddCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="category_name" class="form-label small fw-bold text-muted">Kategória megnevezése</label>
                        <input type="text" id="categoryName" name="categoryName" class="form-control rounded-3" placeholder="pl. Fodrászat, Autószerelés..." required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Mentés</button>
                </div>
            </form>
        </div>
    </div>
</div>