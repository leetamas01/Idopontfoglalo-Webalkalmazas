@model IdopontfoglaloWebalk.Models.Services

@{
    ViewData["Title"] = "Időpont foglalás - " + Model.name;
}

@Html.AntiForgeryToken()

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Search" asp-route-searchQuery="@Model.name" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Vissza a találatokhoz
        </a>
        <h1 class="fw-bold text-dark mt-2">@Model.name</h1>
        <p class="text-muted"><i class="bi bi-geo-alt-fill me-1 text-danger"></i> @Model.address</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-light mb-3">
                <h5 class="fw-bold mb-3">Foglalás menete</h5>
                <p class="small text-secondary">Válassz a naptárban egy neked megfelelő <span class="text-success fw-bold">zöld színű</span> szabad időpontot, majd kattints rá a foglalás véglegesítéséhez.</p>
                <hr />
                <div class="bg-white p-2 rounded-3 border">
                    <p class="small mb-1"><strong>Leírás:</strong></p>
                    <p class="small text-muted mb-0">@Model.description</p>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');

        //Kiolvassuk az Antiforgery tokent a lapról
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            locale: 'hu',
            firstDay: 1,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'timeGridWeek,timeGridDay'
            },
            buttonText: { today: 'Ma', week: 'Hét', day: 'Nap' },
            slotDuration: '00:30:00',
            slotLabelFormat: {
                hour: '2-digit',
                minute: '2-digit',
                meridiem: false,
                hour12: false
            },
            allDaySlot: false,
            slotMinTime: '07:00:00',
            slotMaxTime: '20:00:00',

            events: '/Services/GetCalendarEvents?service_id=' + @Model.service_id,

            eventClick: function(info) {
                var status = info.event.extendedProps.status;

                if (status === 'reserved') {
                    alert('Ez az időpont sajnos már foglalt!');
                    return;
                }

                //Ellenőrizzük a bejelentkezési állapotot

                var isAuthenticated = @(User.Identity.IsAuthenticated.ToString().ToLower());

                if (!isAuthenticated) {
                    if (confirm('Az időpont lefoglalásához be kell jelentkezned. Szeretnél most átlépni a bejelentkezéshez?')) {
                        //Átirányítás a Login felületre
                        window.location.href = '/Users/Login';
                    }
                    return;
                }

                var dateStr = info.event.start ? info.event.start.toLocaleString('hu-HU', {
                    month: 'long',
                    day: 'numeric',
                    weekday: 'short',
                    hour: '2-digit',
                    minute: '2-digit'
                }) : '';

                if (confirm('Biztosan le szeretnéd foglalni ezt az időpontot?\n\n' + info.event.title + '\nIdőpont: ' + dateStr)) {
                    var formData = new FormData();
                    formData.append('occasionId', info.event.id);

                    fetch('/Services/BookOccasion', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data && data.success) {
                                alert(data.message);
                                calendar.refetchEvents();
                            } else if (data && data.requireLogin) {
                                window.location.href = '/Users/Login';
                            } else {
                                alert('Hiba: ' + (data ? data.message : 'Ismeretlen hiba'));
                            }
                        })
                        .catch(err => {
                            console.error('Hiba a foglalás során:', err);
                        });
                }
            }
        });

        calendar.render();
    });
</script>

<style>
    .fc {
        --fc-border-color: #e9ecef;
        --fc-button-bg-color: #0d6efd;
        --fc-button-border-color: #0d6efd;
    }

        .fc .fc-toolbar-title {
            font-size: 1.4rem;
            font-weight: 700;
        }

        .fc .fc-col-header-cell-cushion {
            color: #495057;
            text-decoration: none;
            font-weight: 600;
        }
</style>
