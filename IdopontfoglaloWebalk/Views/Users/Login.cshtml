@{
    ViewData["Title"] = "Bejelentkezés";
}
@model IdopontfoglaloWebalk.Models.LoginViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Üdv újra!</h2>
                        <p class="text-muted">Kérjük, jelentkezz be a foglaláshoz.</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger text-center py-2 small">
                            @ViewBag.ErrorMessage
                        </div>
                    }
                    <form asp-controller="Users" asp-action="Login" method="post">

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="pelda@email.hu">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Jelszó</label>
                            <input asp-for="Password" class="form-control rounded-3 py-2" autocomplete="current-password" required>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe">
                            <label class="form-check-label small text-muted" for="rememberMe">Emlékezz rám</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">
                            Bejelentkezés
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="small text-muted">
                            Még nincs fiókod?
                            <a asp-controller="Users" asp-action="Registration" class="text-primary fw-bold text-decoration-none">Regisztrálj!</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>